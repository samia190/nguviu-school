# KANGARU GIRLS - BACKEND COMPREHENSIVE CONFIG
# THIS IS THE SINGLE SOURCE OF TRUTH FOR ALL ENV VARIABLES
# Copy this file to .env and fill in the actual values
# NEVER commit .env with real credentials to git
# NODE ENVIRONMENT
# Values: development, staging, production
NODE_ENV=production
REQUIRE_AI_PROVIDER=true
ENABLE_LIVE_INVIGILATION=false
# Server Port (PaaS platforms like Render/Railway may override this)
PORT=4000
# DATABASE CONFIGURATION - CRITICAL
# MongoDB Connection URI
# The app checks these in order: MONGO_URI > MONGO_URL > MONGODB_URI > DATABASE_URL
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
# Examples:
#   Local: mongodb://localhost:27017/kangaru_girls_db
#   Atlas: mongodb+srv://user:pass@cluster.mongodb.net/kangaru_girls_db?retryWrites=true&w=majority
#   Railway: Get from Railway plugin or Atlas
#
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/kangaru_girls_db?retryWrites=true&w=majority

# AUTHENTICATION & SECURITY - CRITICAL
# JWT Secret - CHANGE THIS IN PRODUCTION!
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-with-64-hex-chars

# JWT Token Expiration
JWT_EXPIRES_IN=7d

# Initial Admin Setup (set during first deployment)
ADMIN_EMAIL=admin@kangaru-girls.ac.ke
ADMIN_PASSWORD_HASH=your-bcrypt-hash-here

# ID Card Security Secret - for securing student verification tokens
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ID_CARD_SECRET=your-id-card-secret-64-hex-characters-generate-with-command-above
# FRONTEND & CORS CONFIGURATION
# Frontend domain for CORS and password reset links
# Used in email reset links generation
FRONTEND_URL=https://kangarugirls.sc.ke
RESEND_API_KEY=
# CORS Origins (comma-separated list of allowed origins)
# Include: frontend URL, backend URL, localhost for development
# IMPORTANT: If empty, ALL origins are allowed (security risk!)
CORS_ORIGINS=https://kangarugirls.sc.ke,https://api.kangaru-girls.sc.ke
# Keep local files private in production; use authorised object storage instead.
SERVE_LOCAL_UPLOADS=false
# Public Origin (for generating absolute URLs in API responses)
# Used by routes to build full download URLs, file URLs, etc.
# Leave empty to auto-detect from request headers in production
# Set explicitly if behind a proxy/load balancer
PUBLIC_ORIGIN=https://api.kangaru-girls.sc.ke
# EMAIL CONFIGURATION (Nodemailer)
# Option 1: Gmail SMTP (recommended for testing)
# 1. Enable 2FA on Gmail: https://myaccount.google.com/security
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Use below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-not-regular-password
SMTP_FROM=noreply@kangaru-girls.sc.ke
# Reset Token Lifetime (milliseconds)
# 3600000 = 1 hour (recommended)
RESET_TOKEN_EXPIRES_MS=3600000
# OPTIONAL IDENTITY PROVIDERS (disabled unless every required value is set)
# Google is only allowed to issue a session after the verified school-directory record is matched.
ENABLE_GOOGLE_SIGN_IN=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://kangarugirls.sc.ke/api/auth/google/callback
# Phone OTP is only allowed as an additional verified recovery/sign-in factor after directory matching.
ENABLE_PHONE_OTP=false
SMS_OTP_PROVIDER=
SMS_API_URL=
SMS_API_KEY=
SMS_FROM=
# Rate Limiting for Authentication Endpoints
# Prevents brute force attacks on login, register, forgot-password
# Window: 900000ms = 15 minutes
# Max: allows 5 attempts per window
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5
# CLOUDINARY CONFIGURATION (Recommended for Production)
# Free tier: 25GB storage + 25GB bandwidth/month
# Sign up: https://cloudinary.com/users/register/free
# Dashboard: https://console.cloudinary.com
#
# If configured, all file uploads go through Cloudinary CDN.
# If not configured, files are saved to ./public/uploads/ (NOT persistent on Render!)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=kangaru
# AWS S3 FILE STORAGE (Optional - Alternative to Cloudinary)
# Recommended for production to avoid local storage issues
# If not configured, files are saved to ./public/uploads/ locally
#
# Setup:
# 1. Create S3 bucket on AWS
# 2. Create IAM user with S3 access
# 3. Get Access Key & Secret Key
# 4. Set variables below:
#
# S3_BUCKET=your-s3-bucket-name
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# S3_KEY_PREFIX=uploads
# S3_BASE_URL=https://cdn.example.com
# S3_PUBLIC=true
# ADVANCED / OPTIONAL CONFIGURATION
# Logging Level
# Values: debug, info, warn, error
# LOG_LEVEL=info

# KANGARU SCHOLAR STREAMING ASSISTANT PROVIDERS
# Configure the provider order and credentials in the deployment environment only.
AI_PROVIDER_ORDER=groq,openrouter,nvidia
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=20
EXAM_MUTATION_RATE_LIMIT_MAX=60
AI_REQUEST_TIMEOUT=30000
AI_PROVIDER_COOLDOWN_MS=60000
AI_MAX_TOKENS=500
GROQ_API_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODELS=
NVIDIA_API_URL=
NVIDIA_API_KEY=
NVIDIA_MODEL=

# LIVE INVIGILATION RECORDING
# Recording remains disabled until private encrypted object storage is configured.
RECORDING_STORAGE_BUCKET=
