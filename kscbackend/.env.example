# ==========================================
# KANGARU GIRLS - BACKEND CONFIGURATION
# ==========================================
# Copy this file to .env and fill in actual values
# NEVER commit .env with real credentials to git

# ==========================================
# DATABASE CONFIGURATION - CRITICAL
# ==========================================
# MongoDB Connection URI
# The app checks these in order: MONGO_URI > MONGO_URL > MONGODB_URI > DATABASE_URL
#
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
# 
# Examples:
#   Local: mongodb://localhost:27017/kangaru_girls_db
#   Atlas: mongodb+srv://user:pass@cluster.mongodb.net/kangaru_girls_db?retryWrites=true&w=majority
#   Railway: Get from Railway plugin or Atlas
#
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/kangaru_girls_db?retryWrites=true&w=majority

# ==========================================
# AUTHENTICATION & SECURITY
# ==========================================
# JWT Secret - CHANGE THIS IN PRODUCTION!
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# ID Card Security Secret - 32 hex characters
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ID_CARD_SECRET=your-id-card-secret-64-hex-characters

# Initial Admin Setup (set during first deployment)
ADMIN_EMAIL=admin@kangaru-girls.ac.ke
ADMIN_PASSWORD_HASH=your-bcrypt-hash-here

# ==========================================
# APPLICATION ENVIRONMENT
# ==========================================
# Environment: development|staging|production
NODE_ENV=production

# Server Port (Render/Railway auto-assigns - usually ignore in production)
PORT=4000

# ==========================================
# FRONTEND & CORS CONFIGURATION
# ==========================================
# Frontend domain for CORS and password reset links
CLIENT_ORIGIN=https://kangaru-girls.ac.ke

# CORS Origins (comma-separated list of allowed origins)
# Include: frontend URL, backend URL, localhost for development
CORS_ORIGINS=https://kangaru-girls.ac.ke,https://api.kangaru-girls.ac.ke,http://localhost:5173

# Public Origin (for generating absolute URLs)
PUBLIC_ORIGIN=https://api.kangaru-girls.ac.ke

# ==========================================
# EMAIL CONFIGURATION (Nodemailer)
# ==========================================
# Option 1: Gmail SMTP
# 1. Enable 2FA on Gmail
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Use below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@kangaru-girls.ac.ke

# Option 2: SendGrid (uncomment instead of SMTP above)
# SENDGRID_API_KEY=your-sendgrid-api-key
# SENDGRID_FROM=noreply@kangaru-girls.ac.ke

# ==========================================
# PASSWORD RESET & RATE LIMITING
# ==========================================
# Token lifetime: 3600000 = 1 hour
RESET_TOKEN_EXPIRES_MS=3600000

# Rate limiting: 5 attempts per 15 minutes
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5

# ==========================================
# OPTIONAL: AWS S3 FILE STORAGE (Production)
# ==========================================
# Recommended for production to avoid local storage issues
# S3_BUCKET=your-s3-bucket-name
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# S3_BASE_URL=https://cdn.yourcdn.com
# S3_PUBLIC=true
