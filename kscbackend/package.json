{
  "name": "kangaru-girls-unified-backend",
  "version": "2.0.0",
  "description": "Unified backend server for Kangaru Girls website with integrated modules",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "node --test tests/**/*.test.js",
    "db:setup": "node scripts/db-setup.js",
    "db:connect": "node scripts/db-setup.js --connect-only",
    "db:admin": "node scripts/db-setup.js --admin-only",
    "create-admin": "node scripts/create-admin.js",
    "seed:admin": "node seed-admin.mjs",
    "seed:exams": "node scripts/seed-exams.mjs",
    "seed:links": "node scripts/seed-links.mjs",
    "seed:all": "npm run seed:admin && npm run seed:exams && npm run seed:links",
    "migrate:db": "node scripts/migrate-db.mjs",
    "lint": "eslint . --ext .js,.mjs",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "school",
    "education",
    "admin",
    "exams",
    "links"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": "20.x",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.693.0",
    "@aws-sdk/s3-request-presigner": "^3.693.0",
    "axios": "^1.12.0",
    "bcrypt": "^6.0.0",
    "chalk": "^5.3.0",
    "cloudinary": "^2.9.0",
    "compression": "^1.8.1",
    "cookie": "^1.0.2",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "mediasoup": "^3.20.10",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.23.0",
    "multer": "^2.0.2",
    "nanoid": "^5.1.5",
    "nodemailer": "^7.0.10",
    "pdf-parse": "^2.4.5",
    "sharp": "^0.33.5",
    "zod": "^4.1.12"
    ,
    "fuse.js": "^6.6.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.7.0",
    "eslint": "^9.0.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3"
  }
}
