# Backend Development Environment
# See .env.example for full configuration reference
#
# For local development with MongoDB running locally

NODE_ENV=development
PORT=4001

# Local MongoDB (start with: mongod)
MONGO_URI=mongodb://localhost:27017/kangaru_girls_db

# Development secrets (can be simple for local testing)
JWT_SECRET=dev-secret-key-change-in-production-12345678901234567890
JWT_EXPIRES_IN=7d
ID_CARD_SECRET=dev-id-card-secret-change-in-production-12345

# Frontend for CORS
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4000
PUBLIC_ORIGIN=http://localhost:4000

# Gmail SMTP (use your test email with app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-test-email@gmail.com
SMTP_PASS=your-app-password

# Rate limiting in development
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
