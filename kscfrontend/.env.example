# Backend API URL - LOCAL DEVELOPMENT
# For local development, set this to your local backend
VITE_API_URL=http://localhost:4000

# For production deployment (Render/Railway/Netlify), update to your backend URL
# VITE_API_URL=https://your-backend.onrender.com

# Alternative env var name (app checks both)
# VITE_API_ORIGIN=http://localhost:4000

# NOTE: Environment variables must be set at BUILD TIME for Vite
# For local development: Copy this to .env and set VITE_API_URL to http://localhost:4000
# For Render production: Set in the Environment section of your service
# For Netlify production: Set in Site settings > Build & deploy > Environment
