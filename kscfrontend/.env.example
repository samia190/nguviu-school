# ==========================================
# KANGARU GIRLS - FRONTEND COMPREHENSIVE CONFIG
# ==========================================
# THIS IS THE SINGLE SOURCE OF TRUTH FOR ALL ENV VARIABLES
#
# USAGE:
# - Copy this file to .env.local for LOCAL DEVELOPMENT
# - Copy this file to .env.production for PRODUCTION BUILDS
# - Or set variables at BUILD TIME using your deployment platform
# 
# IMPORTANT: Vite only includes variables prefixed with VITE_ in the build.
# These variables are embedded at BUILD TIME, not runtime.
# To change API URL after deployment, you must rebuild the frontend.

# ==========================================
# API CONFIGURATION - CRITICAL
# ==========================================
# Backend API URL
#
# LOCAL DEVELOPMENT:
#   Leave empty - uses Vite proxy to localhost:4000 (vite.config.mjs)
#   VITE_API_URL=
#
# STAGING/PRODUCTION:
#   Set to your backend service URL
#   VITE_API_URL=https://api.kangaru-girls.ac.ke
#
# EXAMPLES:
#   Development: (empty - uses Vite proxy)
#   Production Render: https://kangarugirlsseniorschool-sc-ke.onrender.com
#   Production Netlify: https://api.kangaru-girls.ac.ke
#   Local Staging: http://localhost:4000
#
VITE_API_URL=

# Alternative API Origin (used by some components)
# Leave empty if VITE_API_URL is set
# VITE_API_ORIGIN=http://localhost:4000

# ==========================================
# BUILD OPTIMIZATION
# ==========================================
# Enable/disable source maps in production builds
# Values: true (smaller build but harder to debug)
#         false (larger build but full source maps for debugging)
# RECOMMENDED: false for staging, true for production
VITE_SOURCE_MAP=false

# ==========================================
# THIRD-PARTY SERVICES (Optional)
# ==========================================
# Google Analytics
# VITE_ANALYTICS_ID=UA-XXXXXXXXX-X

# Sentry Error Tracking (https://sentry.io)
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Custom Environment Identifier (useful for distinguishing builds)
# Visible in browser console: console.log(import.meta.env.MODE)
# VITE_ENVIRONMENT=production

# ==========================================
# ADVANCED / VITE-SPECIFIC
# ==========================================
# Mode (automatically set by npm scripts, don't change)
# Values: development (npm run dev)
#         production (npm run build)
# This is automatically inferred by Vite based on the command used
